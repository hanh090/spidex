{
  "name": "spidex",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanh090/spidex.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --mode admin && printf '/* /admin 200\n' > dist-admin/_redirects",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "deploy": "wrangler pages deploy dist --project-name=spidex-app --branch=main",
    "deploy:admin": "wrangler pages deploy dist-admin --project-name=spidex-admin --branch=main",
    "upload:media": "node scripts/upload-pack-media.mjs"
  },
  "dependencies": {
    "@workos-inc/node": "^10.13.0",
    "dexie": "^4.4.5",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^6.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  }
}
