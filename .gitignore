node_modules/
dist/
dev-dist/
.DS_Store
*.local
.env
.env.*
!.env.example

# Pre-migration data snapshots (scripts/migrate_pack_language.py)
backups/

# Generated specimen imagery. Plates are reproducible from scripts/ via the
# spidex:specimen-plate skill, so the bulk archive stays out of git.
public/museum_specimens/
# Pack photography is bulk content and stays out of git. The archetype plates
# are the exception: they are the app's own artwork, a few hundred bytes each,
# and 95% of Butterflies of Vietnam renders one, so the app is wrong without
# them. Ignoring the contents rather than the directory is what lets the
# negation below apply at all.
public/packs/*/img/*
!public/packs/*/img/*archetype*.svg
!public/packs/*/img/*placeholder*.svg
public/packs/*/species.ndjson.bak-*

# Scratch artefacts
scratch_*.png
scratch_*.jpg

# Python bytecode
__pycache__/
*.pyc

# Build artifacts
tsconfig.tsbuildinfo
.wrangler/

# Large exploration / comparison renders, not part of the app
# (regenerable from scripts/: generate_showcase_html, generate_dragonfly_preview,
# generate_model_comparison_html, generate_vn_top100_showcase, generate_archetype_plates)
museum_specimens/
museum_showcase.html
public/museum_showcase.html
public/specimen_showcase.html
public/model_comparison/
public/model_comparison.html
public/gpt5_comparison/
public/gpt5_model_comparison.html
public/dragonfly_preview.html
public/vn_top100.html
public/placeholders/
gpt5_model_comparison.html
scripts/test_output/

# Superseded UI screenshots
public/spidex_*_preview*.png
public/spidex_species_detail_scrolled*.png

# Personal files that landed in the repo root
lich_trinh_nha_trang.*

# Agent tooling config, not application source
.claude/
.agentkit/
.devin/

# Singapore butterfly pack: 126MB of images, too large for git without LFS
public/packs/butterfly-sg/

# Working plans and reports stay local
plans/

# Dev admin store (scratch state for the local /api/admin shim)
data/admin-store.json
