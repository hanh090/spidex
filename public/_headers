# Cloudflare Pages headers.

# The service worker must never be served stale, or a released update can never
# reach an installed client — and vite-plugin-pwa's 'prompt' flow would have
# nothing to prompt about.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Vite emits content-hashed filenames, so these are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pack payloads are versioned by pack id + version in the path and are read
# through the app's own Cache Storage, so a day is plenty at the CDN edge.
/packs/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=604800

# The app renders untrusted pack content and user notes; keep the surface tight.
#
# CSP, by what the app actually loads:
#   script-src   'self'  Vite emits one external module; no inline script, no eval.
#   style-src    'self' + Google Fonts stylesheet (index.html). 'unsafe-inline' is
#                for React inline style props and cannot be verified away without
#                a real browser; styles carry no script capability here.
#   font-src     fonts.gstatic.com (Google Fonts files).
#   img-src      'self' (packs, icons), data:, blob: (captured photo previews),
#                https: (pack images with absolute credit URLs).
#   media-src    'self' + https: (xeno-canto recordings) + blob:.
#   connect-src  'self' only. The client never calls WorkOS directly: OAuth is a
#                top-level redirect (navigation is not governed by connect-src)
#                and the code exchange goes through /api/auth/callback.
#   worker-src   'self' (service worker).
# Pack files served by the packs Function carry their own stricter
# `script-src 'none'` policy; Pages does not apply this file to Function responses.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
