# Cloudflare Pages headers.

# The service worker must never be served stale, or a released update can never
# reach an installed client — and vite-plugin-pwa's 'prompt' flow would have
# nothing to prompt about.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Vite emits content-hashed filenames, so these are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pack payloads are versioned by pack id + version in the path and are read
# through the app's own Cache Storage, so a day is plenty at the CDN edge.
/packs/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=604800

# The app renders untrusted pack content and user notes; keep the surface tight.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
