# Spidex Environment Variables Template
# Copy to .env and fill in real values

# WorkOS AuthKit
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxx
WORKOS_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
WORKOS_REDIRECT_URI=http://localhost:5173/auth/callback

# Session signing (production). Falls back to WORKOS_API_KEY when unset;
# set it to rotate sessions without touching WorkOS.
SESSION_SECRET=

# Admin console: comma-separated emails allowed into /api/admin/* and /admin.
# Unset means nobody is admin — the gate fails closed.
ADMIN_EMAILS=you@example.com

# Bird-voice pipeline (scripts/fetch_bird_voices.py). Free key from
# https://xeno-canto.org/account — required for API v3 since Oct 2025.
XENO_CANTO_API_KEY=
