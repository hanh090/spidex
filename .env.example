# Spidex environment variables. Copy to .env for `npm run dev`; set the same
# names as Pages secrets/variables in production
# (`wrangler pages secret put NAME --project-name spidex-app`).
# Everything is optional for local guest mode: without WorkOS keys the app runs
# signed-out, and sign-in endpoints answer {user:null}.

# WorkOS AuthKit (sign-in). Redirect URIs are configured in the WorkOS
# dashboard: add http://localhost:5173/auth/callback and your deployed
# https://<site>/auth/callback there.
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxx
WORKOS_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Session signing (production). Falls back to WORKOS_API_KEY when unset;
# set it to rotate sessions without touching WorkOS.
SESSION_SECRET=

# Admin console: comma-separated emails allowed into /api/admin/* and /admin.
# Unset means nobody is admin — the gate fails closed.
ADMIN_EMAILS=you@example.com

# Credits: metered always; set to 1 to actually charge (photo backup stops at
# a zero balance). Unset or 0 means nothing is ever blocked.
CREDITS_ENFORCED=0

# Oldest client version allowed (dotted, e.g. 0.2.0). Older installed apps get
# a non-blocking "update required" banner once a newer version is available.
MIN_CLIENT_VERSION=

# Where `npm run dev` fetches bundled pack media missing from the checkout
# (the media lives in R2, not git). Set to `off` to work fully offline with
# only the fixture packs (bird-min, butterfly-min).
SPIDEX_MEDIA_ORIGIN=https://spidex-app.pages.dev

# Deploy/upload tooling (shell env, not the app): the Cloudflare account that
# owns the spidex-app Pages project, D1 database and spidex-packs bucket.
CLOUDFLARE_ACCOUNT_ID=

# Bird-voice pipeline (scripts/fetch_bird_voices.py). Free key from
# https://xeno-canto.org/account — required for API v3 since Oct 2025.
XENO_CANTO_API_KEY=
